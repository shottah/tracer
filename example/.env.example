# RPC configuration — set one of these (DRPC_API_KEY wins if both are set).
#
# dRPC key: one key covers every chain in lib/chains.ts (Ethereum, Base,
# Arbitrum One, and their Sepolia testnets), reached at
# https://lb.drpc.live/<chain>/<key>. dRPC documents debug_* tracing as
# paid-tier only.
# DRPC_API_KEY=
#
# Or a single JSON-RPC endpoint; its chain comes from eth_chainId. Any plain
# RPC works — when it lacks debug_traceTransaction, tracer automatically
# falls back to a local anvil fork (needs Foundry installed).
ETH_RPC_URL=http://127.0.0.1:8545

# Optional: explicit path to the tracer binary. Defaults to
# ../target/release/tracer, then ../target/debug/tracer, then $PATH.
# TRACER_BIN=/path/to/tracer

# Optional: run with --deep by default (storage reads/writes + exact event
# interleaving). Set to 0 to disable; per-request override: ?deep=1 / ?deep=0.
# Note: tracing a local anvil directly requires `anvil --steps-tracing`.
TRACER_DEEP=1

# Optional: force a tracing backend (auto | rpc | anvil-fork).
# Set to "rpc" on serverless deployments (no anvil available there).
# TRACER_BACKEND=rpc

# Optional: inline address labels (same shape as labels.json) — useful on
# serverless platforms where shipping a labels.json file is awkward.
# LABELS_JSON={"0x1a9ad59713b85750ef2f9cd8433f898a65c654a4":"VFE"}

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX). Unset = no
# analytics tag. NEXT_PUBLIC_* is inlined at build time, so on hosted
# deployments it must be available to the build, not just the runtime.
# NEXT_PUBLIC_GA_ID=
